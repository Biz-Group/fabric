# Convex
NEXT_PUBLIC_CONVEX_URL=

# ElevenLabs
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# The following secrets are stored as Convex environment variables (never client-side):
# ELEVENLABS_API_KEY — used by fetchConversation and getAudio actions
#
# AI provider — Microsoft Foundry is the only one. There is no provider switch:
# every AI call resolves to Foundry or raises AIConfigurationError.
# FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
# FOUNDRY_API_KEY — account key shared by the Foundry deployments
# FOUNDRY_SYNTHESIS_BACKEND=claude|gpt5mini
# FOUNDRY_CLAUDE_DEPLOYMENT=fabric-claude-haiku-4-5
# FOUNDRY_OPENAI_FALLBACK_DEPLOYMENT=fabric-gpt5-mini-fallback
# FOUNDRY_SAFETY_DEPLOYMENT=fabric-description-safety
#
# AI usage metering (see docs/ai-usage-metering-plan.md):
# USAGE_DEPLOYMENT_LABEL=prod|dev — tags every ledger row with its deployment.
#   Unset defaults to "dev": an unconfigured deployment is not the one we set up,
#   and under-reporting prod is self-announcing where polluting it is not.
# USAGE_SINK_URL — dev ONLY. The prod sink's /ai-usage/ingest. Two traps:
#   1. It is .convex.site, NOT .convex.cloud — HTTP actions live on the former.
#   2. A regionalized deployment carries its region in the host, e.g.
#      https://<deployment>.eu-west-1.convex.site/ai-usage/ingest. Copy the
#      "HTTP Actions URL" from the deployment's dashboard verbatim rather than
#      composing it — omitting the region resolves to a different host that
#      answers a bare 404, which looks identical to a missing route.
#   Left unset on prod, which is how the forwarding cron knows it has nothing
#   to forward.
# USAGE_SINK_SECRET — shared bearer secret for that route; must match on both
#   deployments. While unset on prod the route returns 404, so an unconfigured
#   sink never advertises the endpoint.
